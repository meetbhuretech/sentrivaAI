# SENTINELAI local development — placeholder values only. Copy to .env and fill in.

# --- Core ---
APP_ENV=local
APP_NAME=SENTINELAI
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# JSON array (pydantic-settings) or comma-separated after Settings validator
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Database ---
POSTGRES_USER=sentinelai
POSTGRES_PASSWORD=sentinelai
POSTGRES_DB=sentinelai
DATABASE_URL=postgresql+asyncpg://sentinelai:sentinelai@postgres:5432/sentinelai
DATABASE_URL_SYNC=postgresql://sentinelai:sentinelai@postgres:5432/sentinelai

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth bootstrap (first admin; change after login) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin123!
BOOTSTRAP_ADMIN_NAME=SENTINELAI Admin

# --- AI providers (optional; leave empty for deterministic-only mode) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
DEFAULT_AI_PROVIDER=deterministic
DEFAULT_AI_MODEL=rules-v1

# --- Investigation budgets ---
INVESTIGATION_TIMEOUT_SECONDS=120
AGENT_TIMEOUT_SECONDS=30
MAX_TOOL_CALLS=40
MAX_TOKENS_PER_INVESTIGATION=80000
MAX_ESTIMATED_COST_USD=1.00

# --- Telemetry / OTEL ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://api:8000/api/v1/telemetry/otlp
OTEL_SERVICE_NAME=sentinelai-api
PROMETHEUS_URL=http://prometheus:9090

# --- Simulator ---
SIMULATOR_INTERNAL_TOKEN=change-me-simulator-token
GATEWAY_URL=http://gateway:8100
USER_SERVICE_URL=http://user-service:8101
ORDER_SERVICE_URL=http://order-service:8102
PAYMENT_SERVICE_URL=http://payment-service:8103

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:8000

# --- Detection ---
ENABLE_DETECTION_SCHEDULER=true
DETECTION_INTERVAL_SECONDS=30

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
